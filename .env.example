# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Secret Key (generate a strong random hex in production)
SECRET_KEY=bondquiz-super-secret-key-change-in-production-2026

# Database URI (defaults to SQLite bondquiz.sqlite in the project root)
DATABASE_URL=sqlite:///bondquiz.sqlite
